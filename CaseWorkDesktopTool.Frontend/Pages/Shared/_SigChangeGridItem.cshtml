@using CaseWorkDesktopTool.Frontend.ViewModels;
@using CaseWorkDesktopTool.Application.Common.Models;
@using System.Globalization

@model CaseworkViewModel<SigChange>

<form>
    <div class="row mb-3">
        <div class="col-sm-2 fw-bold">Trust</div>
        <div class="col-sm-10">@Model.Data.TrustName</div>
    </div>

    <div class="row mb-3">
        <div class="col-sm-2 fw-bold">URN</div>
        <div class="col-sm-10">@Model.Data.Urn</div>
    </div>

    <div class="row mb-3">
        <div class="col-sm-2 fw-bold">LA</div>
        <div class="col-sm-10">@Model.Data.LocalAuthority</div>
    </div>

    <div class="row mb-3">
        <div class="col-sm-2 fw-bold">Region</div>
        <div class="col-sm-10">@Model.Data.Region</div>
    </div>

    <div class="row mb-3">
        <div class="col-sm-2 fw-bold">Type</div>
        <div class="col-sm-10">@Model.Label</div>
    </div>

    <div class="row mb-3">
        @{
            DateTime parsedDate;
            if (DateTime.TryParse(Model.Data.DecisionDate?.ToString(), out parsedDate))
            {
                <div class="col-sm-2 fw-bold">Date of decision</div>
                <div class="col-sm-10">@parsedDate.ToString("MM/dd/yyyy")</div>
            }
            else
            {
                <div class="d-flex align-items-center">
                    <div class="col-sm-2 fw-bold">Date of decision</div>
                    <div class="col-sm-10">
                        <div class="d-inline-flex p-1 border border-1 bg-success text-dark bg-opacity-10">Empty</div>
                    </div>
                </div>
            }
        }
    </div>
</form>
